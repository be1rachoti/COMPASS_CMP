# Copy to .env for local development. Never commit a real .env.
# In production these come from a secret manager (AWS Secrets Manager, Vault,
# Parameter Store), not from a file on disk.

ENVIRONMENT=local          # local | test | staging | production
DEBUG=false

# ---------------------------------------------------------------- database
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=cmp
POSTGRES_USER=cmp
POSTGRES_PASSWORD=cmp
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_STATEMENT_TIMEOUT_MS=15000

# ------------------------------------------------------------------- redis
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ---------------------------------------------------------------- security
# Production refuses to start if this is left at a development value.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=local-development-secret-key-not-for-production-use

SESSION_TTL_S=28800          # absolute lifetime: 8 hours
SESSION_IDLE_TIMEOUT_S=1800  # sliding idle timeout: 30 minutes
COOKIE_SECURE=false          # true in anything served over HTTPS
COOKIE_SAMESITE=lax

# R-AUT-03. Keyed on the account, not the address: an attacker rotates addresses.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_S=1800
LOGIN_LOCKOUT_DURATION_S=1800

OTP_TTL_S=600
OTP_MAX_VERIFY_ATTEMPTS=5
MFA_REQUIRED_ROLES=dpo,admin

# -------------------------------------------------------------------- CORS
# Comma-separated. Must be explicit in production - "*" is refused at startup.
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=*

# ----------------------------------------------------------------- uploads
MAX_UPLOAD_BYTES=26214400    # 25 MB. Nginx enforces the same cap at the edge.
UPLOAD_ROOT=./var/uploads

# ----------------------------------------------------------------- logging
LOG_LEVEL=INFO
LOG_JSON=true                # false for human-readable output in a terminal

# ---------------------------------------------------------------- external
NOTIFICATION_EMAIL_FROM=privacy@example.org
EXTERNAL_HTTP_TIMEOUT_S=10   # never infinite
